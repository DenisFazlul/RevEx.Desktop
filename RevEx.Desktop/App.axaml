<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RevEx.Desktop"
             x:Class="RevEx.Desktop.App"
             RequestedThemeVariant="Light">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/RevExStyles.axaml" />
    </Application.Styles>
</Application>

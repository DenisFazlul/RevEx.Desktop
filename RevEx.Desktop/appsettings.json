{
  "AppSettings": {
    "ApiPath": "http://localhost:8080/",
    "Authentication": {
      "Provider": "Keycloak",
      "RedirectUri": "http://127.0.0.1:7890/",
      "Providers": {
        "Keycloak": {
          "Authority": "http://localhost:8081/realms/revex",
          "ClientId": "revex-desktop",
          "Scope": "openid profile",
          "RequireHttpsMetadata": false,
          "RefreshTokenRevocationEndpoint": "http://localhost:8081/realms/revex/protocol/openid-connect/logout"
        },
        "ActiveDirectory": {}
      }
    }
  }
}

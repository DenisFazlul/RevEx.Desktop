<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RevEx.Desktop.Views.Common.OperationErrorWindow"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="Description" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="Reference" FontSize="12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CopyButton" Content="Копировать сведения" MinHeight="32" Click="OnCopyClick" />
            <Button Content="Закрыть" MinHeight="32" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>

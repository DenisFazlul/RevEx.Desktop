<common:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:common="using:RevEx.Desktop.Views.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Common"
        x:DataType="vm:TextInputViewModel"
        x:Class="RevEx.Desktop.Views.Common.TextInputWindow"
        Title="{Binding Options.WindowTitle}" Width="540" Height="360"
        MinWidth="460" MinHeight="320" WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="24" RowDefinitions="Auto,18,*,Auto">
        <HeaderedContentControl Theme="{StaticResource DialogHeaderTheme}"
                                Header="{Binding Options.FormTitle}" Content="{Binding Options.Hint}" />

        <StackPanel Grid.Row="2" Spacing="9">
            <HeaderedContentControl Theme="{StaticResource FormFieldTheme}" Header="{Binding Options.FieldLabel}">
                <TextBox x:Name="ValueBox" Text="{Binding Text}"
                         Classes.multiline="{Binding Options.IsMultiline}"
                         MaxLength="{Binding Options.MaximumLength}" />
            </HeaderedContentControl>
            <TextBlock Text="{Binding ValidationMessage}" Classes="validation-message" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,10,Auto">
            <Button Grid.Column="1" Classes="secondary" Content="Отмена" Command="{Binding CancelCommand}" />
            <Button Grid.Column="3" Classes="primary" Content="Сохранить" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</common:DialogWindow>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels"
        xmlns:tabVm="using:RevEx.Desktop.ViewModels.Tabs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="RevEx.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico" Title="RevEx"
        Width="1180" Height="760" MinWidth="860" MinHeight="560">
    <Grid RowDefinitions="64,*">
        <Border Classes="app-toolbar">
            <Grid Margin="22,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Classes="brand-mark">
                        <TextBlock Text="R" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="RevEx" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Knowledge workspace" Foreground="#8F8F9D" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Padding="10,5" CornerRadius="12" Background="#26262F" VerticalAlignment="Center">
                    <TextBlock Text="DESKTOP" Foreground="#B6B2E9" FontSize="10" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Classes="workspace-tabs"
                    ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="tabVm:WorkspaceTabViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                        <Button Classes="ghost" Width="24" Height="24" Padding="0" IsVisible="{Binding CanClose}"
                                Click="OnCloseTabClick" Content="×" FontSize="16" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="tabVm:WorkspaceTabViewModel">
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RevEx.Desktop.Views.AuthenticationProgressWindow"
        Title="Вход в RevEx"
        Width="500"
        Height="250"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Border Classes="card section-card">
            <Grid RowDefinitions="Auto,16,*,16,Auto" ColumnDefinitions="38,12,*">
                <Border Classes="icon-tile" Width="38" Height="38">
                    <PathIcon Width="18" Height="18"
                              Data="M9,2 A7,7 0 1 0 16,9 M9,5 L9,9 L12,11" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="h2" Text="Завершите вход в браузере" />
                    <TextBlock Classes="caption" Text="RevEx ожидает подтверждение авторизации" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Row="2" Grid.ColumnSpan="3"
                           Classes="caption"
                           Text="Если вкладка была закрыта, откройте страницу входа повторно. Ожидание завершится через 3 минуты."
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="4" Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Открыть браузер снова" Click="OnReopenBrowserClick" />
                    <Button Classes="primary" Content="Отмена" Click="OnCancelClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

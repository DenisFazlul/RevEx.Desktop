<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RevEx.Desktop.ViewModels.MainMenu"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="650"
             x:Class="RevEx.Desktop.Views.MainMenu.MainMenuView" x:DataType="vm:MainMenuViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="48,42" RowDefinitions="Auto,32,Auto" MaxWidth="1040" HorizontalAlignment="Center">
            <StackPanel Spacing="10">
                <Border Classes="eyebrow" HorizontalAlignment="Left">
                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" />
                </Border>
                <TextBlock Classes="h1" Text="С чего начнём?" />
                <TextBlock Classes="caption" FontSize="15"
                           Text="Откройте нужный раздел — он появится в отдельной вкладке и останется под рукой." />
            </StackPanel>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding BtnLinks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="300" ItemHeight="154" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BtnLink">
                        <Button Classes="menu-card" Content="{Binding Name}" Command="{Binding OpenCommand}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>

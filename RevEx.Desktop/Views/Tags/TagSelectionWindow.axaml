<common:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:common="using:RevEx.Desktop.Views.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="using:RevEx.Domain.Contracts.Tag"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Tags"
        x:Class="RevEx.Desktop.Views.Tags.TagSelectionWindow"
        x:DataType="vm:TagSelectionWindowViewModel"
        Title="Добавить тег" Width="440" Height="400"
        MinWidth="360" MinHeight="300" WindowStartupLocation="CenterOwner">
    <Grid Margin="12" RowDefinitions="Auto,12,*,12,Auto">
        <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Доступные теги" />
            <TextBlock Classes="caption" Text="Выберите один тег для добавления к контенту" />
        </StackPanel>
        <Border Grid.Row="2" Classes="value-box" Padding="4">
            <Grid>
                <TextBlock IsVisible="{Binding !HasTags}" Text="Все доступные теги уже добавлены."
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ListBox Classes="clean-list category-list" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedItem}"
                         IsVisible="{Binding HasTags}" DoubleTapped="OnTagDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:TagDto">
                            <Grid Margin="4" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name, StringFormat='#{0}'}" FontWeight="Medium" />
                                <TextBlock Grid.Column="1" Text="{Binding TagGroupName}" Classes="caption" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Row="4" ColumnDefinitions="*,8,*">
            <Button Content="Отмена" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="Добавить" Command="{Binding AcceptCommand}" />
        </Grid>
    </Grid>
</common:DialogWindow>

<common:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:common="using:RevEx.Desktop.Views.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Common"
        x:DataType="vm:DeleteConfirmationViewModel"
        x:Class="RevEx.Desktop.Views.Tags.DeleteConfirmationWindow"
        Title="Подтверждение удаления" Width="440" Height="230"
        MinWidth="400" MinHeight="210" WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="16" RowDefinitions="Auto,8,*,Auto">
        <TextBlock Classes="h2" Text="Удалить?" />
        <TextBlock Grid.Row="2" Text="{Binding Description}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Grid Grid.Row="3" ColumnDefinitions="*,12,*">
            <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Classes="danger" Content="Удалить"
                    IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" />
        </Grid>
    </Grid>
</common:DialogWindow>

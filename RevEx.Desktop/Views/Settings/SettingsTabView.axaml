<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RevEx.Desktop.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:DataType="vm:SettingsTabViewModel" x:Class="RevEx.Desktop.Views.Settings.SettingsTabView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,36" RowDefinitions="Auto,24,Auto" MaxWidth="900" HorizontalAlignment="Center">
            <HeaderedContentControl Theme="{StaticResource PageHeaderTheme}" Header="Настройки"
                                    Content="Подключение и параметры рабочего пространства" />
            <HeaderedContentControl Grid.Row="2" Theme="{StaticResource ApiSettingsCardTheme}"
                                    Header="API-сервер" Content="{Binding ApiPath}" />
        </Grid>
    </ScrollViewer>
</UserControl>

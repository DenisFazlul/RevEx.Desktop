<common:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:common="using:RevEx.Desktop.Views.Common"
        xmlns:models="using:RevEx.Desktop.ViewModels.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Catalog"
        xmlns:categories="using:RevEx.Desktop.ViewModels.Categories"
        xmlns:tags="using:RevEx.Desktop.ViewModels.Tags"
        x:Class="RevEx.Desktop.Views.Catalog.CatalogSettingsWindow"
        x:DataType="vm:CatalogSettingsViewModel"
        Title="Категории и теги"
        Width="640" Height="440"
        MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="ListBox.filter-options ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="12,12,12,8" Spacing="4">
            <TextBlock Classes="h2" Text="Фильтр каталога" />
            <TextBlock Classes="caption"
                       Text="Выберите категории и теги материалов, которые нужно показать" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="12,0" ColumnDefinitions="*,12,*">
            <Border Classes="content-pane">
                <Grid RowDefinitions="Auto,8,*">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Категории" />
                        <TextBlock Classes="caption" Text="Можно выбрать несколько" />
                    </StackPanel>
                    <ListBox Grid.Row="2" Classes="clean-list filter-options" ItemsSource="{Binding Categories}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FilterItemViewModel">
                                <CheckBox Margin="0" MinHeight="28" Padding="4,0" Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="content-pane">
                <Grid RowDefinitions="Auto,8,*">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Теги" />
                        <TextBlock Classes="caption" Text="Материал должен содержать все выбранные теги" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="2" Classes="clean-list filter-options" ItemsSource="{Binding Tags}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FilterItemViewModel">
                                <CheckBox Margin="0" MinHeight="28" Padding="4,0" Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
                <Button Classes="secondary" Content="Сбросить" Command="{Binding ResetCommand}" />
                <Button Grid.Column="2" Classes="secondary" Content="Отмена" Command="{Binding CancelCommand}" />
                <Button Grid.Column="4" Classes="primary" Content="Применить" Command="{Binding ApplyCommand}" />
            </Grid>
        </Border>
    </Grid>
</common:DialogWindow>

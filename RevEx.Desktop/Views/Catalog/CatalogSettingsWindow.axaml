<common:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:common="using:RevEx.Desktop.Views.Common"
        xmlns:models="using:RevEx.Desktop.ViewModels.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Catalog"
        xmlns:categories="using:RevEx.Desktop.ViewModels.Categories"
        xmlns:tags="using:RevEx.Desktop.ViewModels.Tags"
        x:Class="RevEx.Desktop.Views.Catalog.CatalogSettingsWindow"
        x:DataType="vm:CatalogSettingsViewModel"
        Title="Категории и теги"
        Width="640" Height="440"
        MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Expander.tag-group">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        </Style>
        <Style Selector="Expander.tag-group /template/ ToggleButton">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <DataTemplate x:Key="FilterItem" x:DataType="models:FilterItemViewModel">
            <CheckBox IsChecked="{Binding IsSelected}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}"
                             IsVisible="{Binding ColorBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Name}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
        <DataTemplate x:Key="FilterGroup" x:DataType="vm:CatalogFilterGroupViewModel">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" MinHeight="32" Padding="8,4" FontSize="12"
                            Content="Выбрать все" Command="{Binding SelectAllCommand}" />
                    <Button Classes="secondary" MinHeight="32" Padding="8,4" FontSize="12"
                            Content="Снять все" Command="{Binding ClearCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource FilterItem}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid RowDefinitions="*,Auto">
        <Grid Margin="12,12,12,0" ColumnDefinitions="*,12,2*">
            <Border Classes="content-pane">
                <Grid RowDefinitions="Auto,8,*">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Категории" />
                        <TextBox PlaceholderText="Поиск по категориям"
                                 AutomationProperties.Name="Поиск по категориям"
                                 Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding Categories}" ContentTemplate="{StaticResource FilterGroup}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="content-pane">
                <Grid RowDefinitions="Auto,8,*">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Теги" />
                        <TextBox PlaceholderText="Поиск по тегам"
                                 AutomationProperties.Name="Поиск по тегам"
                                 Text="{Binding TagSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VisibleTagGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CatalogFilterGroupViewModel">
                                    <Expander Classes="tag-group" Padding="8,4" Margin="0,0,0,4"
                                              IsExpanded="{Binding IsSearchActive, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                                <Button Classes="secondary" MinHeight="32" Padding="8,4" FontSize="12"
                                                        Content="Выбрать все" Command="{Binding SelectAllCommand}" />
                                                <Button Classes="secondary" MinHeight="32" Padding="8,4" FontSize="12"
                                                        Content="Снять все" Command="{Binding ClearCommand}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Text="{Binding DisplayName}" />
                                            </DockPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource FilterItem}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,8,0,0" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
                <Button Classes="secondary" Content="Сбросить" Command="{Binding ResetCommand}" />
                <Button Grid.Column="2" Classes="secondary" Content="Отмена" Command="{Binding CancelCommand}" />
                <Button Grid.Column="4" Classes="primary" Content="Применить" Command="{Binding ApplyCommand}" />
            </Grid>
        </Border>
    </Grid>
</common:DialogWindow>

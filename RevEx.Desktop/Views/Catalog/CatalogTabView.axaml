<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevEx.Desktop.ViewModels.Catalog"
             xmlns:categoryVm="using:RevEx.Desktop.ViewModels.Categories"
             xmlns:contentVm="using:RevEx.Desktop.ViewModels.Contents"
             xmlns:tagVm="using:RevEx.Desktop.ViewModels.Tags"
             x:Class="RevEx.Desktop.Views.Catalog.CatalogTabView" x:DataType="vm:CatalogTabViewModel">
    <Grid Margin="28" RowDefinitions="Auto,22,*">
        <Grid ColumnDefinitions="*,340">
            <HeaderedContentControl Theme="{StaticResource PageHeaderTheme}" Header="Каталог"
                                    Content="Материалы, инструкции и документы команды" />
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox Classes="search" Watermark="Поиск по названию…"
                         Text="{Binding ContentNameQuery}" />
                <PathIcon Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left"
                          Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                          Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M12.5,12.5 L17,17" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="250,24,*">
            <Border Classes="side-panel">
                <Grid RowDefinitions="Auto,14,*,18,Auto,14,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="Категории" />
                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8" Background="{StaticResource SurfaceBrush}">
                            <PathIcon Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}"
                                      Data="M3,5 L15,5 M5,9 L13,9 M7,13 L11,13" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" VerticalAlignment="Top" />
                        <ListBox Classes="clean-list category-list" ItemsSource="{Binding Categories}"
                                 IsVisible="{Binding !IsLoading}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="categoryVm:CategoryItemViewModel">
                                    <CheckBox Padding="8" Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                              HorizontalAlignment="Stretch" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="3" Classes="section-separator" />
                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="Теги" />
                        <TextBlock Grid.Column="1" Classes="caption" Text="необязательно" />
                    </Grid>
                    <Grid Grid.Row="6">
                        <ListBox Classes="clean-list category-list" ItemsSource="{Binding Tags}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="tagVm:TagFilterItemViewModel">
                                    <CheckBox Padding="8" Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                              HorizontalAlignment="Stretch" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="content-pane">
                <Grid RowDefinitions="Auto,14,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="h2" Text="Материалы" />
                            <TextBlock Classes="caption" Text="Дважды нажмите, чтобы открыть" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="9,4" CornerRadius="8" Background="{StaticResource SurfaceMutedBrush}">
                            <TextBlock Text="БИБЛИОТЕКА" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <StackPanel IsVisible="{Binding IsContentLoading}" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="12">
                            <ProgressBar Width="120" IsIndeterminate="True" />
                            <TextBlock Classes="caption" Text="Загружаем материалы…" />
                        </StackPanel>
                        <ListBox Classes="clean-list content-list" ItemsSource="{Binding Contents}"
                                 IsVisible="{Binding !IsContentLoading}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="contentVm:ContentItemViewModel">
                                    <Border Classes="content-row" Margin="0,0,0,8"
                                            DoubleTapped="OnContentDoubleTapped">
                                        <Grid ColumnDefinitions="84,14,*">
                                            <Border Width="84" Height="72" CornerRadius="8" ClipToBounds="True"
                                                    Background="{StaticResource SurfaceMutedBrush}">
                                                <Grid>
                                                    <TextBlock Text="Нет фото" Classes="caption"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasPreview}" />
                                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                                           IsVisible="{Binding HasPreview}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <ItemsControl ItemsSource="{Binding VisibleTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Classes="value-box" Padding="8,3" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding StringFormat='#{0}'}" Classes="caption"
                                                                               Foreground="{StaticResource AccentBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Classes="value-box" Padding="8,3"
                                                            IsVisible="{Binding HasAdditionalTags}">
                                                        <TextBlock Text="{Binding AdditionalTagsText}" Classes="caption"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:filter="using:RevEx.Desktop.ViewModels.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:RevEx.Desktop.Views.Common"
             xmlns:vm="using:RevEx.Desktop.ViewModels.Catalog"
             xmlns:contentVm="using:RevEx.Desktop.ViewModels.Contents"
             x:Class="RevEx.Desktop.Views.Catalog.CatalogTabView" x:DataType="vm:CatalogTabViewModel">
    <Grid Margin="12" RowDefinitions="Auto,12,*">
        <Grid ColumnDefinitions="Auto,8,240">
            <Button Classes="secondary" VerticalAlignment="Center"
                    Content="Фильтры" Click="OnOpenCatalogSettingsClick" />
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <TextBox Classes="search" PlaceholderText="Поиск по названию…"
                         Text="{Binding ContentNameQuery}" />
                <PathIcon Width="16" Height="16" Margin="8,0,0,0" HorizontalAlignment="Left"
                          Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"
                          Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M12.5,12.5 L17,17" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding IsContentLoading}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="12">
                <common:LoadingIndicator />
                <TextBlock Classes="caption" Text="Загружаем материалы…" />
            </StackPanel>
            <ListBox Classes="clean-list content-list" ItemsSource="{Binding Contents}"
                     IsVisible="{Binding !IsContentLoading}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="contentVm:ContentItemViewModel">
                        <Border Classes="content-row" DoubleTapped="OnContentDoubleTapped">
                            <Grid ColumnDefinitions="64,12,*">
                                <Border Width="64" Height="56" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SurfaceMutedBrush}">
                                    <Grid>
                                        <TextBlock Text="Нет фото" Classes="caption"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasPreview}" />
                                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                               IsVisible="{Binding HasPreview}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                    <WrapPanel Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding VisibleTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="filter:FilterItemViewModel">
                                                    <Border Classes="value-box" Padding="8,0" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" />
                                                            <TextBlock Text="{Binding Name, StringFormat='#{0}'}" Classes="caption"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Classes="value-box" Padding="8,0"
                                                IsVisible="{Binding HasAdditionalTags}">
                                            <TextBlock Text="{Binding AdditionalTagsText}" Classes="caption"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>

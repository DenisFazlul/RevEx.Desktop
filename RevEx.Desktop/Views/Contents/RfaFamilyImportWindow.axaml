<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
        xmlns:revit="clr-namespace:RevEx.Domain.Contracts.Revit;assembly=RevEx.Contracts"
        x:Class="RevEx.Desktop.Views.Contents.RfaFamilyImportWindow"
        x:DataType="vm:RfaFamilyImportViewModel"
        Title="Добавить семейство RFA" Width="860" Height="780"
        MinWidth="640" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="24" RowDefinitions="Auto,16,*,16,Auto">
        <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="Добавить семейство RFA" />
            <TextBlock Classes="caption" Text="Выберите семейство, проверьте прочитанные данные и сохраните новую версию."
                       TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,12,Auto">
                    <TextBox Text="{Binding FileName}" IsReadOnly="True" />
                    <Button Grid.Column="2" Content="Выбрать RFA" Click="OnChooseFileClick"
                            IsEnabled="{Binding CanChooseFile}" />
                </Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding TargetDescription}" TextWrapping="Wrap" />
                <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto">
                        <TextBlock Classes="label" Text="Название контента (из имени файла)" />
                        <TextBox Grid.Row="2" Text="{Binding ContentName}" IsReadOnly="True" />
                        <TextBlock Grid.Column="2" Classes="label" Text="Коннектор чтения" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding ConnectorName}" IsReadOnly="True" />
                    </Grid>
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto">
                        <TextBlock Classes="label" Text="Категория в каталоге" />
                        <ComboBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberBinding="{Binding Name}" IsEnabled="{Binding CanEditContent}" />
                        <TextBlock Grid.Column="2" Classes="label" Text="Категория семейства" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FamilyCategory}" IsReadOnly="True" />
                    </Grid>
                    <TextBlock Classes="label" Text="Описание" />
                    <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                             MaxLength="2000" IsReadOnly="{Binding !CanEditContent}" />
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto">
                        <TextBlock Classes="label" Text="Название новой версии" />
                        <TextBox Grid.Row="2" Text="{Binding VersionName}" MaxLength="200"
                                 IsReadOnly="{Binding !CanEditVersion}" />
                        <TextBlock Grid.Column="2" Classes="label" Text="Год Revit" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding ApplicationVersion}" MaxLength="4"
                                 IsReadOnly="{Binding !CanEditVersion}" />
                    </Grid>
                </StackPanel>
                <Expander Header="Типоразмеры и параметры семейства">
                    <ItemsControl ItemsSource="{Binding FamilyTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="revit:RevitFamilyReadResultType">
                                <StackPanel Margin="0,8" Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="revit:RevitFamilyReadResultTypeParameter">
                                                <Grid ColumnDefinitions="*,12,*" Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Expander Header="Метаданные, которые будут сохранены с файлом">
                    <TextBox Text="{Binding MetadataJson}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="240" />
                </Expander>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding !HasError}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding Message}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="OnCancelClick" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="primary" Content="Сохранить новую версию" Click="OnSaveClick"
                    IsEnabled="{Binding CanSave}" />
        </StackPanel>
    </Grid>
</Window>

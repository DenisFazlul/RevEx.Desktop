<common:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:common="using:RevEx.Desktop.Views.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
        xmlns:revit="using:RevEx.Desktop.Views.Revit"
        x:Class="RevEx.Desktop.Views.Contents.RfaFamilyImportWindow"
        x:DataType="vm:RfaFamilyImportViewModel"
        Title="Добавить семейство RFA" Width="860" Height="780"
        MinWidth="640" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="16" RowDefinitions="Auto,12,*,12,Auto">
        <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Добавить семейство RFA" />
            <TextBlock Classes="caption" Text="Выберите коннектор и откройте один RFA вместе с нужными CSV и IFC. Читается только RFA; вспомогательные файлы сохраняются с той же версией."
                       TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="Коннектор чтения" />
                    <ComboBox ItemsSource="{Binding Connectors}" SelectedItem="{Binding SelectedConnector}"
                              DisplayMemberBinding="{Binding Name}" IsEnabled="{Binding CanChangeConnector}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,12,Auto">
                    <TextBox Text="{Binding FileName}" IsReadOnly="True" />
                    <Button Grid.Column="2" Content="Открыть" Click="OnChooseFileClick"
                            IsEnabled="{Binding CanChooseFile}" />
                </Grid>
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="Вспомогательные файлы (CSV, IFC)" />
                    <TextBlock Text="{Binding AuxiliaryFileNames}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{Binding TargetDescription}" TextWrapping="Wrap" />
                <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
                    <Grid RowDefinitions="Auto,8,Auto">
                        <TextBlock Classes="label" Text="Название контента (из имени файла)" />
                        <TextBox Grid.Row="2" Text="{Binding ContentName}" IsReadOnly="True" />
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto">
                        <TextBlock Classes="label" Text="Категория в каталоге" />
                        <ComboBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberBinding="{Binding Name}" IsEnabled="{Binding CanEditContent}" />
                        <TextBlock Grid.Column="2" Classes="label" Text="Категория семейства" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FamilyCategory}" IsReadOnly="True" />
                    </Grid>
                    <TextBlock Classes="label" Text="Описание" />
                    <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                             MaxLength="2000" IsReadOnly="{Binding !CanEditContent}" />
                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto">
                        <TextBlock Classes="label" Text="Название новой версии" />
                        <TextBox Grid.Row="2" Text="{Binding VersionName}" MaxLength="200"
                                 IsReadOnly="{Binding !CanEditVersion}" />
                        <TextBlock Grid.Column="2" Classes="label" Text="Год Revit" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding ApplicationVersion}" MaxLength="4"
                                 IsReadOnly="{Binding !CanEditVersion}" />
                    </Grid>
                </StackPanel>
                <Expander Header="Метаданные семейства" IsExpanded="True">
                    <revit:RevitFamilyReadResultView DataContext="{Binding FamilyMetadata}" />
                </Expander>
                <Expander Header="Метаданные, которые будут сохранены с файлом">
                    <TextBox Text="{Binding MetadataJson}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="240" />
                </Expander>
                <common:OperationFeedbackView />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="primary" Content="Сохранить новую версию" Command="{Binding SaveAndCloseCommand}"
                    IsEnabled="{Binding CanSave}" />
        </StackPanel>
    </Grid>
</common:DialogWindow>

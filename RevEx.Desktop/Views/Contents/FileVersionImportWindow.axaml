<common:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:common="using:RevEx.Desktop.Views.Common"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
        x:Class="RevEx.Desktop.Views.Contents.FileVersionImportWindow"
        x:DataType="vm:FileVersionImportViewModel"
        Title="Добавить версию из файла" Width="620" Height="460"
        MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="16" RowDefinitions="Auto,12,*,12,Auto">
        <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Добавить версию из файла" />
            <TextBlock Classes="caption"
                       Text="Версия и метаданные будут созданы из свойств выбранного файла."
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="12">
            <Grid ColumnDefinitions="*,12,Auto">
                <TextBox Text="{Binding FileName}" IsReadOnly="True" />
                <Button Grid.Column="2" Content="Выбрать файл" Click="OnChooseFileClick"
                        IsEnabled="{Binding CanChooseFile}" />
            </Grid>
            <Border Classes="card section-card">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Margin" Value="8,4" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Styles>
                    <Border Grid.ColumnSpan="2" Background="{StaticResource SurfaceMutedBrush}" />
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceMutedBrush}" />
                    <TextBlock Classes="caption" Text="Расширение" />
                    <TextBlock Grid.Column="1" Text="{Binding Extension}" />
                    <TextBlock Grid.Row="1" Classes="caption" Text="Размер" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" />
                    <TextBlock Grid.Row="2" Classes="caption" Text="Создан" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreationTimeText}" />
                    <TextBlock Grid.Row="3" Classes="caption" Text="Изменён" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastWriteTimeText}" />
                </Grid>
            </Border>
            <common:OperationFeedbackView />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="primary" Content="Добавить версию" Command="{Binding SaveAndCloseCommand}"
                    IsEnabled="{Binding CanSave}" />
        </StackPanel>
    </Grid>
</common:DialogWindow>

<common:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:common="using:RevEx.Desktop.Views.Common"
                     xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
                     xmlns:sets="using:RevEx.Domain.Contracts.ContentSet"
                     x:Class="RevEx.Desktop.Views.Contents.ContentSetsWindow"
                     x:DataType="vm:ContentSetsViewModel"
                     Title="Выбор набора" Width="620" Height="560" MinWidth="440" MinHeight="400"
                     WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Classes="h2" Text="Выбор набора" Margin="0,0,0,12" />
        <TextBox Grid.Row="1" Text="{Binding Search}" PlaceholderText="Поиск по названию, описанию, автору или ID"
                 AutomationProperties.Name="Поиск набора" Margin="0,0,0,12" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" IsEnabled="{Binding !IsBusy}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sets:ContentSetDto">
                    <common:ContentSetRowView />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" Classes="status-message" Margin="0,8" />
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,8,Auto">
            <common:LoadingIndicator IsVisible="{Binding IsBusy}" />
            <Button Grid.Column="1" Content="Отмена" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button IsDefault="True" Grid.Column="3" Content="Добавить в набор" Classes="primary" Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>
    </Grid>
</common:DialogWindow>

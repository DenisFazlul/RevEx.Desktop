<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
             x:Class="RevEx.Desktop.Views.Contents.ContentVersionDetailsView"
             x:DataType="vm:ContentVersionDetailsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,30" RowDefinitions="Auto,22,Auto,16,Auto" MaxWidth="880"
              HorizontalAlignment="Center">
            <HeaderedContentControl Theme="{StaticResource PageHeaderTheme}"
                                    Header="{Binding Version.Name}"
                                    Content="Детализация версии контента" />

            <Border Grid.Row="2" Classes="card section-card">
                <StackPanel Spacing="16">
                    <TextBlock Classes="h2" Text="Информация о версии" />
                    <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,14,Auto,14,Auto">
                        <HeaderedContentControl Theme="{StaticResource InfoFieldTheme}"
                                                Header="Приложение" Content="{Binding Version.Application}" />
                        <HeaderedContentControl Grid.Column="2" Theme="{StaticResource InfoFieldTheme}"
                                                Header="Версия приложения"
                                                Content="{Binding Version.ApplicationVersion}" />
                        <HeaderedContentControl Grid.Row="2" Theme="{StaticResource InfoFieldTheme}"
                                                Header="Статус" Content="{Binding Version.Status}" />
                        <HeaderedContentControl Grid.Row="2" Grid.Column="2"
                                                Theme="{StaticResource InfoFieldTheme}"
                                                Header="Дата версии" Content="{Binding DateText}" />
                        <HeaderedContentControl Grid.Row="4" Theme="{StaticResource InfoFieldTheme}"
                                                Header="Создано" Content="{Binding CreatedAtText}" />
                        <HeaderedContentControl Grid.Row="4" Grid.Column="2"
                                                Theme="{StaticResource InfoFieldTheme}"
                                                Header="Обновлено" Content="{Binding UpdatedAtText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Classes="card section-card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="h2" Text="Файлы версии" />
                    <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" />
                    <TextBlock IsVisible="{Binding HasNoFiles}" Classes="caption"
                               Text="У версии нет прикреплённых файлов." />
                    <TextBlock Classes="validation-message" Text="{Binding ErrorMessage}" />
                    <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContentVersionFileItemViewModel">
                                <Border Classes="value-box" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto,18,Auto">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Role}" />
                                        <TextBlock Grid.Column="3" Classes="caption" Text="{Binding SizeText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

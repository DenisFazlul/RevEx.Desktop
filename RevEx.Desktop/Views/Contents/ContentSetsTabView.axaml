<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:RevEx.Desktop.Views.Common"
             xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
             xmlns:sets="using:RevEx.Domain.Contracts.ContentSet"
             x:Class="RevEx.Desktop.Views.Contents.ContentSetsTabView"
             x:DataType="vm:ContentSetsTabViewModel">
    <Grid Margin="12" RowDefinitions="Auto,12,*,Auto">
        <Grid ColumnDefinitions="*,12,Auto">
            <TextBox Classes="search" Text="{Binding Search}" PlaceholderText="Поиск наборов по названию, описанию или автору" />
            <Button Grid.Column="2" Content="Создать набор" Classes="primary" Click="OnCreateClick" IsEnabled="{Binding !IsBusy}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="2*,16,5*">
            <ListBox Classes="clean-list" ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}"
                     IsEnabled="{Binding !IsBusy}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sets:ContentSetDto">
                        <common:ContentSetRowView />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2" RowDefinitions="Auto,12,*">
                <StackPanel Spacing="8" IsVisible="{Binding HasSelectedSet}">
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBlock Classes="h2" Text="{Binding SelectedSet.Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" x:Name="SetActionsButton" Classes="icon" IsEnabled="{Binding !IsBusy}"
                                ToolTip.Tip="Действия с набором" AutomationProperties.Name="Действия с набором">
                            <PathIcon Width="18" Height="18" Data="M2,3 L18,3 L18,5 L2,5 Z M2,9 L18,9 L18,11 L2,11 Z M2,15 L18,15 L18,17 L2,17 Z" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Изменить набор" Click="OnEditClick" />
                                    <MenuItem Header="Удалить набор" Command="{Binding DeleteCommand}"
                                              Foreground="{DynamicResource DangerBrush}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SelectedSet.Description}" TextWrapping="Wrap" MaxHeight="120" />
                    <TextBlock Text="{Binding SelectedSet.Author, StringFormat='Автор: {0}'}" Classes="caption" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsBusy}">
                        <Button Content="Убрать из набора" Command="{Binding RemoveCommand}" IsEnabled="{Binding HasSelectedContent}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2">
                    <StackPanel IsVisible="{Binding IsContentLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <common:LoadingIndicator />
                        <TextBlock Classes="caption" Text="Загружаем материалы…" />
                    </StackPanel>
                    <ListBox Classes="clean-list content-list" ItemsSource="{Binding Contents}" SelectedItem="{Binding SelectedContent}"
                             IsVisible="{Binding !IsContentLoading}" IsEnabled="{Binding !IsBusy}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContentItemViewModel">
                                <common:ContentRowView DoubleTapped="OnContentDoubleTapped" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock IsVisible="{Binding !HasSelectedSet}" Text="Выберите набор, чтобы посмотреть его содержимое."
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0">
            <common:LoadingIndicator IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding Message}" Classes="status-message" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:RevEx.Desktop.Views.Common"
             xmlns:domain="using:RevEx.Domain.Contracts.ContentVersion"
        xmlns:history="using:RevEx.Desktop.ViewModels.Contents"
             xmlns:revitViews="using:RevEx.Desktop.Views.Revit"
             xmlns:contentViews="using:RevEx.Desktop.Views.Contents"
             xmlns:parameter="using:RevEx.Domain.Contracts.Content"
             xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
             x:Class="RevEx.Desktop.Views.Contents.ContentDetailsView"
             x:DataType="vm:ContentDetailsViewModel">
    <Grid Margin="12" HorizontalAlignment="Stretch" RowDefinitions="Auto,*">
        <TextBlock Margin="0,0,0,8" Text="Контент заморожен. Доступен только просмотр."
                   IsVisible="{Binding IsFrozen}" TextWrapping="Wrap" />
        <TabControl Grid.Row="1">
            <TabItem Header="Основное">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,16,0,0" ColumnDefinitions="2*,12,3*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                            <Button Content="Скопировать ID" Click="OnCopyIdClick"
                                    ToolTip.Tip="Скопировать ID для открытия через меню «Открыть по ID»" />
                            <TextBlock x:Name="CopyIdStatus" VerticalAlignment="Center" />
                            <ToggleButton Classes="subscription"
                                          IsChecked="{Binding IsSubscribed, Mode=OneWay}"
                                          Command="{Binding ToggleSubscriptionCommand}"
                                          IsEnabled="{Binding !IsChangingSubscription}"
                                          ToolTip.Tip="{Binding SubscriptionTip}">
                                <TextBlock Text="{Binding SubscriptionTip}" />
                            </ToggleButton>
                            <TextBlock Text="{Binding SubscriptionMessage}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Row="1" Classes="card section-card" Margin="0,12,0,0">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h2" Text="Изображение" />
                                    <Button Grid.Column="1" Classes="icon" Click="OnUpdatePreviewClick"
                                            IsVisible="{Binding HasEditPermission}"
                                             ToolTip.Tip="Обновить изображение">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="CanEdit" />
                                                <Binding Path="!IsUpdatingPreview" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                        <PathIcon Data="M13,5 L13,1 L11.5,2.5 A6,6 0 1 0 13.5,9 M13,1 L9,1" />
                                    </Button>
                                </Grid>
                                <common:LoadingIndicator IsVisible="{Binding IsUpdatingPreview}" />
                                <Border Classes="image-frame" MinHeight="200">
                                    <Grid>
                                        <common:ContentImagePlaceholder IsVisible="{Binding HasNoPreview}" />
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                               IsVisible="{Binding HasPreview}" MaxHeight="256" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding PreviewMessage}" Classes="status-message" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Classes="card section-card" Margin="0,12,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h2" Text="Основная информация" />
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Grid.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Margin" Value="8,4" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </Grid.Styles>
                                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceMutedBrush}" />
                                    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceMutedBrush}" />
                                    <TextBlock Grid.Row="0" Classes="caption" Text="Название" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />
                                    <Button Grid.Row="0" Grid.Column="2" Classes="icon" Click="OnEditNameClick"
                                            IsVisible="{Binding HasEditPermission}"
                                             ToolTip.Tip="Изменить название">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="CanEdit" />
                                                <Binding Path="!IsSavingContent" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                        <PathIcon Data="M3,11 L3,14 L6,14 L14,6 L11,3 Z M10,4 L13,7 M3,14 L7,13" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Classes="caption" Text="Описание" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}" />
                                    <Button Grid.Row="1" Grid.Column="2" Classes="icon" Click="OnEditDescriptionClick"
                                            IsVisible="{Binding HasEditPermission}"
                                             ToolTip.Tip="Изменить описание">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="CanEdit" />
                                                <Binding Path="!IsSavingContent" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                        <PathIcon Data="M3,11 L3,14 L6,14 L14,6 L11,3 Z M10,4 L13,7 M3,14 L7,13" />
                                    </Button>
                                    <TextBlock Grid.Row="2" Classes="caption" Text="Категория" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CategoryName}" />
                                    <Button Grid.Row="2" Grid.Column="2" Classes="icon" Click="OnEditCategoryClick"
                                            IsVisible="{Binding HasEditPermission}"
                                             ToolTip.Tip="Изменить категорию">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="CanEdit" />
                                                <Binding Path="!IsSavingContent" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                        <PathIcon Data="M3,11 L3,14 L6,14 L14,6 L11,3 Z M10,4 L13,7 M3,14 L7,13" />
                                    </Button>
                                </Grid>
                                <common:LoadingIndicator IsVisible="{Binding IsSavingContent}" />
                                <TextBlock Text="{Binding ContentMessage}" Classes="status-message" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Classes="card section-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h2" Text="Теги" />
                                    <Button Grid.Column="1" Classes="primary" Content="Добавить тег"
                                            IsVisible="{Binding HasEditPermission}"
                                            Click="OnAddTagClick">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="CanEdit" />
                                                <Binding Path="!IsSavingTags" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                </Grid>
                                <common:LoadingIndicator IsVisible="{Binding IsSavingTags}" />
                                <TextBlock IsVisible="{Binding HasNoTags}" Text="У контента пока нет тегов."
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ContentTagItemViewModel">
                                            <Border Classes="tag">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" />
                                                    <TextBlock Text="{Binding Name, StringFormat='#{0}'}" VerticalAlignment="Center" />
                                                    <Button Classes="icon-sm" Command="{Binding RemoveCommand}"
                                                            IsEnabled="{Binding $parent[UserControl].((vm:ContentDetailsViewModel)DataContext).CanEdit}" IsVisible="{Binding $parent[UserControl].((vm:ContentDetailsViewModel)DataContext).HasEditPermission}" ToolTip.Tip="Удалить тег">
                                                        <PathIcon Data="M2,3 L3,2 L10,9 L9,10 Z M9,2 L10,3 L3,10 L2,9 Z" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding TagMessage}" Classes="status-message" />

                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0" Classes="card section-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h2" Text="Параметры" />
                                    <Button Grid.Column="1" Content="Добавить параметр" Click="OnAddParameterClick"
                                            IsVisible="{Binding HasEditPermission}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="CanEdit" />
                                                <Binding Path="!IsLoading" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="2*,*,2*,112" ColumnSpacing="8">
                                    <TextBlock Classes="caption" Text="Название" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="Тип" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="Значение" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="parameter:ContentParameterDto">
                                            <Grid ColumnDefinitions="2*,*,2*,112" ColumnSpacing="8" Margin="0,4" Background="Transparent" ToolTip.Tip="{Binding Help}">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Kind, Converter={x:Static vm:ContentParameterRowViewModel.KindLabelConverter}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                                                <Button Grid.Column="3" Content="Изменить"
                                                        IsEnabled="{Binding $parent[UserControl].((vm:ContentDetailsViewModel)DataContext).CanEdit}" IsVisible="{Binding $parent[UserControl].((vm:ContentDetailsViewModel)DataContext).HasEditPermission}"
                                                        Click="OnEditParameterClick" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ParameterMessage}" TextWrapping="Wrap" Classes="status-message" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Версии">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,8,Auto,12,*">
                    <ListBox ItemsSource="{Binding VersionPlatforms}"
                             SelectedItem="{Binding SelectedVersionPlatform, Mode=TwoWay}"
                             SelectionMode="Single" IsEnabled="{Binding !IsVersionBusy}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="12,4" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionPlatformOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,8,*,8,Auto">
                        <TextBlock Classes="label" Text="Версия" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding FilteredVersions}"
                                  SelectedItem="{Binding SelectedVersion, Mode=OneWay}"
                                  SelectionChanged="OnVersionSelectionChanged"
                                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsVersionBusy}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:ContentVersionDto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Classes="caption"
                                                   Text="{Binding PublishStatus, Converter={StaticResource PublishStatusConverter}, StringFormat='({0})'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="4" Classes="primary compact" Content="Добавить"
                                IsVisible="{Binding HasEditPermission}"
                                Click="OnAddVersionClick">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="CanEdit" />
                                    <Binding Path="CanAddVersion" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="4" IsVisible="{Binding HasNoPlatformVersions}"
                               Classes="caption" Text="Для выбранной платформы пока нет версий." />
                    <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" IsVisible="{Binding HasSelectedVersion}">
                            <Border Classes="card section-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="h2" Text="{Binding SelectedVersion.Name}" />
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <Grid.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="Margin" Value="8,4" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </Grid.Styles>
                                        <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceMutedBrush}" />
                                        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceMutedBrush}" />
                                        <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceMutedBrush}" />
                                        <TextBlock Classes="caption" Text="Версия приложения" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.ApplicationVersion}" />
                                        <TextBlock Grid.Row="1" Classes="caption" Text="Платформа" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.Platform}" />
                                        <TextBlock Grid.Row="2" Classes="caption" Text="Дата версии" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersionDateText}" />
                                        <TextBlock Grid.Row="3" Classes="caption" Text="Файлов" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VersionFiles.Count}" />
                                        <TextBlock Grid.Row="4" Classes="caption" Text="Создано" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVersionCreatedAtText}" />
                                        <TextBlock Grid.Row="5" Classes="caption" Text="Обновлено" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedVersionUpdatedAtText}" />
                                        <TextBlock Grid.Row="6" Classes="caption" Text="Статус публикации" />
                                        <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,8,Auto" Margin="8,4">
                                            <ComboBox ItemsSource="{Binding PublishStatuses}"
                                                      SelectedItem="{Binding SelectedPublishStatus}"
                                                      DisplayMemberBinding="{Binding Name}"
                                                      IsEnabled="{Binding CanChangePublishStatus}" />
                                            <Button Grid.Column="2" Content="Сохранить статус"
                                                    IsEnabled="{Binding CanEdit}" IsVisible="{Binding HasEditPermission}"
                                                    Command="{Binding SavePublishStatusCommand}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card section-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="h2" Text="Файлы версии" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="primary" Content="Загрузить в проект"
                                                Click="OnLoadVersionIntoProjectClick"
                                                IsEnabled="{Binding CanLoadVersionIntoProject}" />
                                    </Grid>
                                    <common:LoadingIndicator IsVisible="{Binding IsVersionBusy}" />
                                    <TextBlock IsVisible="{Binding HasNoVersionFiles}" Classes="caption"
                                               Text="У версии нет прикреплённых файлов." />
                                    <TextBlock Classes="validation-message" Text="{Binding VersionErrorMessage}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VersionMessage}" Classes="status-message" />
                                    <ItemsControl ItemsSource="{Binding VersionFiles}" IsVisible="{Binding HasVersionFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ContentVersionFileItemViewModel">
                                                <Border Classes="value-box" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto,8,Auto,12,Auto,8,Auto,8,Auto">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding RoleName}" />
                                                        <TextBlock Grid.Column="3" Classes="caption" Text="{Binding SizeText}" />
                                                        <Button Grid.Column="5" Classes="secondary compact" Content="Скачать"
                                                                Click="OnDownloadVersionFileClick" />
                                                        <Button Grid.Column="7" Classes="secondary compact" Content="Просмотр"
                                                                IsVisible="{Binding IsIfc}"
                                                                Click="OnPreviewIfcFileClick" />
                                                        <Button Grid.Column="9" Classes="compact danger" Content="Удалить"
                                                                IsEnabled="{Binding $parent[UserControl].((vm:ContentDetailsViewModel)DataContext).CanEdit}" IsVisible="{Binding $parent[UserControl].((vm:ContentDetailsViewModel)DataContext).HasEditPermission}"
                                                                Click="OnDeleteVersionFileClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="card section-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="h2" Text="Метаданные версии" />
                                    <Border IsVisible="{Binding IsRevitVersion}">
                                        <revitViews:RevitFamilyReadResultView DataContext="{Binding VersionFamilyMetadata}" />
                                    </Border>
                                    <Border IsVisible="{Binding IsOtherVersion}">
                                        <contentViews:OtherFileMetadataView DataContext="{Binding OtherFileMetadata}" />
                                    </Border>
                                    <TextBlock Classes="caption" Text="{Binding VersionMetadataMessage}"
                                               TextWrapping="Wrap" />
                                    <TextBox Text="{Binding VersionMetadataJson}" IsReadOnly="True"
                                             IsVisible="{Binding HasGenericVersionMetadata}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="320" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="История изменений">
                <Border Margin="0,16,0,0" Classes="card section-card">
                    <Grid RowDefinitions="Auto,8,*">
                        <TextBlock Classes="h2" Text="История изменений контента и версий" />
                        <TextBlock Grid.Row="2" IsVisible="{Binding HasNoHistory}"
                                   Text="История изменений пока пуста."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid Grid.Row="2" IsVisible="{Binding HasHistory}" RowDefinitions="Auto,*">
                            <Border Classes="value-box" Padding="8,4">
                                <Grid ColumnDefinitions="180,*,180,150">
                                    <TextBlock FontWeight="SemiBold" Text="Время" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Описание" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Автор" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Действия" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="history:ContentHistoryEventViewModel">
                                            <Border Classes="value-box" Margin="0,4,0,0" Padding="8,4">
                                                <Grid ColumnDefinitions="180,*,180,150">
                                                    <TextBlock Text="{Binding OccurredAtText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="2" Margin="8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Author}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Classes="secondary compact"
                                                            Content="Показать детали"
                                                            Click="OnShowHistoryDetailsClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Настройки">
                <TabItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="HasEditPermission" />
                        <Binding Path="CanChangeFreeze" />
                    </MultiBinding>
                </TabItem.IsVisible>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0" Spacing="12">
                        <Button Content="{Binding FreezeActionText}" IsVisible="{Binding CanChangeFreeze}"
                                Command="{Binding ToggleFreezeCommand}" MinHeight="32" />
                        <Expander IsVisible="{Binding HasEditPermission}" IsExpanded="False"
                                  BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                            <Expander.Header>
                                <TextBlock Text="Красная зона" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <Button Classes="danger" Content="Удалить семейство" Click="OnDeleteContentClick"
                                        IsEnabled="{Binding !IsDeleting}" MinHeight="32" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="using:RevEx.Desktop.Core.Domain"
             xmlns:vm="using:RevEx.Desktop.ViewModels.Contents"
             x:Class="RevEx.Desktop.Views.Contents.ContentDetailsView" x:DataType="vm:ContentDetailsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,30" RowDefinitions="Auto,22,Auto,16,Auto,16,Auto" MaxWidth="880" HorizontalAlignment="Center">
            <HeaderedContentControl Theme="{StaticResource EyebrowHeaderTheme}"
                                    Header="{Binding Title}" Content="Карточка материала из базы знаний" />
            <HeaderedContentControl Grid.Row="2" Theme="{StaticResource DetailsCardTheme}"
                                    Header="Описание" Content="{Binding Description}" />
            <Border Grid.Row="4" Classes="card section-card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="Теги контента" />
                            <TextBlock Classes="caption" Text="Только уже добавленные метки" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" Content="Добавить тег"
                                Click="OnAddTagClick" IsEnabled="{Binding !IsSavingTags}" />
                    </Grid>
                    <ProgressBar IsVisible="{Binding IsSavingTags}" IsIndeterminate="True" />
                    <TextBlock IsVisible="{Binding HasNoTags}" Text="У контента пока нет тегов."
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContentTagItemViewModel">
                                <Border Classes="value-box" Padding="11,6" Margin="0,0,7,7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name, StringFormat='#{0}'}" VerticalAlignment="Center" />
                                        <Button Classes="ghost" Width="24" Height="24" MinHeight="24" Padding="0"
                                                Command="{Binding RemoveCommand}" ToolTip.Tip="Удалить тег">
                                            <PathIcon Width="11" Height="11"
                                                      Data="M2,3 L3,2 L10,9 L9,10 Z M9,2 L10,3 L3,10 L2,9 Z" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TagMessage}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Classes="card section-card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="Версии" />
                        <Button Grid.Column="1" Classes="primary"
                                Content="Добавить версию"
                                Command="{Binding AddVersionCommand}" />
                    </Grid>

                    <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" />
                    <TextBlock IsVisible="{Binding HasNoVersions}"
                               Text="У контента пока нет версий."
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <ItemsControl ItemsSource="{Binding Versions}" IsVisible="{Binding HasVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:ContentVersionDto">
                                <Border Classes="value-box" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="2*,*,*,Auto">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ApplicationVersion, StringFormat='Revit {0}'}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FileIds.Count, StringFormat='Файлов: {0}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<Styles xmlns="https://github.com/avaloniaui">
    <!-- Card surfaces and small reusable visual primitives. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.side-panel">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.content-pane">
        <Setter Property="Padding" Value="2,4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.section-card">
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.details-card">
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.settings-card">
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.value-box">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.content-row">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.content-row:pointerover">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Border.icon-tile">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Border.icon-tile TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.eyebrow">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Border.eyebrow TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.welcome-mark">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.welcome-mark TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.workspace-hint">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Border.section-separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Composite components. Screens consume these through Theme={StaticResource ...}. -->
    <Styles.Resources>
        <ControlTheme x:Key="PageHeaderTheme" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h1" Text="{TemplateBinding Header}" />
                        <TextBlock Classes="caption" Text="{TemplateBinding Content}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="DialogHeaderTheme" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h2" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="FormFieldTheme" TargetType="HeaderedContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="7">
                        <TextBlock Classes="label" Text="{TemplateBinding Header}" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="InfoFieldTheme" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{TemplateBinding Header}" />
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="EyebrowHeaderTheme" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="8">
                        <Border Classes="eyebrow" HorizontalAlignment="Left">
                            <TextBlock Text="МАТЕРИАЛ" />
                        </Border>
                        <TextBlock Classes="h1" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{TemplateBinding Content}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="ContentRowTheme" TargetType="HeaderedContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="content-row">
                        <Grid ColumnDefinitions="36,12,*,Auto">
                            <Border Classes="icon-tile" Width="36" Height="36">
                                <PathIcon Width="17" Height="17"
                                          Data="M4,2 L11,2 L15,6 L15,18 L4,18 Z M11,2 L11,6 L15,6 M7,10 L12,10 M7,13 L12,13" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" FontSize="14" Text="{TemplateBinding Header}" />
                                <TextBlock Classes="caption" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" Text="{TemplateBinding Content}" />
                            </StackPanel>
                            <PathIcon Grid.Column="3" Width="14" Height="14" Margin="12,0,2,0"
                                      Foreground="{StaticResource TextTertiaryBrush}"
                                      Data="M5,2 L11,8 L5,14" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="DetailsCardTheme" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="card details-card">
                        <Grid RowDefinitions="Auto,18,Auto">
                            <Grid ColumnDefinitions="38,12,*">
                                <Border Classes="icon-tile" Width="38" Height="38">
                                    <PathIcon Width="18" Height="18"
                                              Data="M4,2 L11,2 L15,6 L15,18 L4,18 Z M11,2 L11,6 L15,6 M7,10 L12,10 M7,13 L12,13" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="h2" Text="{TemplateBinding Header}" />
                                    <TextBlock Classes="caption" Text="Основная информация" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Classes="section-separator" />
                            <TextBlock Grid.Row="2" Classes="body-copy" Text="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="ApiSettingsCardTheme" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="card settings-card">
                        <Grid RowDefinitions="Auto,18,Auto" ColumnDefinitions="42,14,*">
                            <Border Classes="icon-tile" Width="42" Height="42">
                                <PathIcon Width="19" Height="19"
                                          Data="M6,10 C6,7.8 7.8,6 10,6 L13,6 C15.2,6 17,7.8 17,10 C17,12.2 15.2,14 13,14 L11,14 M14,10 C14,12.2 12.2,14 10,14 L7,14 C4.8,14 3,12.2 3,10 C3,7.8 4.8,6 7,6 L9,6" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="h2" Text="{TemplateBinding Header}" />
                                <TextBlock Classes="caption" Text="Адрес, по которому приложение получает данные" />
                            </StackPanel>
                            <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="value-box">
                                <Grid ColumnDefinitions="Auto,16,*">
                                    <Ellipse Classes="status-dot" />
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding Content}" FontFamily="monospace"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Button.menu-card">
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="MenuCardSurface" Classes="card" Padding="16">
                    <Grid ColumnDefinitions="38,14,*,Auto">
                        <Border Classes="icon-tile" Width="38" Height="38" VerticalAlignment="Center">
                            <PathIcon Width="18" Height="18"
                                      Data="M4,10 L16,10 M11,5 L16,10 L11,15" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{TemplateBinding Content}" />
                            <TextBlock Classes="caption" Text="Открыть рабочий раздел" />
                        </StackPanel>
                        <PathIcon Grid.Column="3" Width="14" Height="14" VerticalAlignment="Center"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  Data="M5,2 L11,8 L5,14" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.menu-card:pointerover /template/ Border#MenuCardSurface">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    </Style>
</Styles>
